# ProcureSaathi Environment Configuration

# TinyFish Web Research Agent API
# Sign up at https://agent.tinyfish.ai/api-keys to obtain your key
TINYFISH_API_KEY=your_tinyfish_api_key_here
TINYFISH_SEARCH_URL=https://api.search.tinyfish.ai
TINYFISH_FETCH_URL=https://api.fetch.tinyfish.ai

# Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Simulation & Fallback Mode
# Set to 'true' to allow realistic fallback data if TinyFish quota is exceeded or offline
ENABLE_MOCK_FALLBACK=true
